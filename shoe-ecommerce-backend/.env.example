PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shoestore
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Optional: password reset emails (links are logged to the console when unset)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional: card payments
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional: PayPal payments
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox

# reCAPTCHA v3 SECRET key. Protects register, login and forgot-password.
# Required in production; skipped locally when empty.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
